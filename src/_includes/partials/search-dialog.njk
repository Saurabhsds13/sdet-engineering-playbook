<div class="search-dialog" data-search-dialog hidden>
  <div class="search-dialog__backdrop" data-search-close></div>
  <div class="search-dialog__panel" role="dialog" aria-modal="true" aria-label="Search the playbook">
    <div class="search-dialog__input-row">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
      <input type="search" class="search-dialog__input" data-search-input placeholder="Search articles, topics, interview questions…" aria-label="Search" autocomplete="off" spellcheck="false" />
      <kbd class="search-dialog__esc">Esc</kbd>
    </div>
    <div class="search-dialog__results" data-search-results role="listbox" aria-label="Search results">
      <p class="search-dialog__hint">Type to search across the playbook.</p>
    </div>
  </div>
</div>
